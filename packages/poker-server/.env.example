# Copy to .env and adjust as needed.
PORT=4000
# Secret used to sign JWTs. CHANGE THIS in production.
JWT_SECRET=dev-secret-change-me
# Comma-separated list of allowed web origins (CORS).
CLIENT_ORIGIN=http://localhost:5174
# SQLite database file path.
DATABASE_PATH=./data/poker.db
# Starting bankroll granted to a new account.
STARTING_CHIPS=10000
# Seconds a player has to act before auto-fold/check.
TURN_SECONDS=30

# Build-time env for the Vite client (Vite inlines these — rebuild after changes).
# In dev these default to the Vite proxy (/api and same-origin socket).
# On Vercel set these to your deployed game server when the backend is hosted.

# REST base URL. Empty/"/api" uses same-origin (dev proxy). e.g. https://your-server.example.com/api
VITE_API_URL=/api

# Socket.IO server URL. Empty uses same-origin (dev proxy). e.g. https://your-server.example.com
VITE_SOCKET_URL=
